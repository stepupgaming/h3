{
  "irVersion":1,
  "name":"comfy-workflow-h3-singularity-encode",
  "nodes":{
    "1":{
      "type":"CLIPLoader",
      "params":{
        "clip_name":{
          "$param":"clip"
        },
        "type":"minimax",
        "device":"cpu"
      },
      "inputs":{}
    },
    "2":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "3":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"audio_vae"
        }
      },
      "inputs":{}
    },
    "4":{
      "type":"LoadImage",
      "params":{
        "image":{
          "$param":"ref_image"
        }
      },
      "inputs":{}
    },
    "5":{
      "type":"MiniMaxH3ReferenceToVideo",
      "params":{
        "prompt":{
          "$param":"prompt"
        },
        "width":{
          "$param":"width"
        },
        "height":{
          "$param":"height"
        },
        "length":{
          "$param":"length"
        },
        "ref_image_size":"max"
      },
      "inputs":{
        "clip":{
          "node":"1",
          "out":0
        },
        "vae":{
          "node":"2",
          "out":0
        },
        "audio_vae":{
          "node":"3",
          "out":0
        },
        "ref_images.ref_image_0":{
          "node":"4",
          "out":0
        }
      }
    },
    "6":{
      "type":"GemmyH3SaveConditioning",
      "params":{
        "filename_prefix":{
          "$param":"cond_prefix"
        }
      },
      "inputs":{
        "conditioning":{
          "node":"5",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "STRING"
      ],
      "outputNames":[
        "path"
      ]
    },
    "7":{
      "type":"GemmyH3SaveAVLatent",
      "params":{
        "filename_prefix":{
          "$param":"latent_prefix"
        },
        "fingerprint":{
          "$param":"fingerprint"
        }
      },
      "inputs":{
        "samples":{
          "node":"5",
          "out":1
        }
      }
    }
  },
  "outputs":[
    {
      "node":"6",
      "out":0
    },
    {
      "node":"7",
      "out":0
    }
  ],
  "params":{
    "clip":{
      "name":"clip",
      "type":"string",
      "default":"qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae":{
      "name":"audio_vae",
      "type":"string",
      "default":"minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt":{
      "name":"prompt",
      "type":"string"
    },
    "width":{
      "name":"width",
      "type":"int",
      "default":544
    },
    "height":{
      "name":"height",
      "type":"int",
      "default":960
    },
    "length":{
      "name":"length",
      "type":"int",
      "default":124
    },
    "ref_image":{
      "name":"ref_image",
      "type":"combo"
    },
    "cond_prefix":{
      "name":"cond_prefix",
      "type":"string",
      "default":"h3/singularity_cond"
    },
    "latent_prefix":{
      "name":"latent_prefix",
      "type":"string",
      "default":"h3/singularity_empty"
    },
    "fingerprint":{
      "name":"fingerprint",
      "type":"string",
      "default":"{}"
    }
  }
}
