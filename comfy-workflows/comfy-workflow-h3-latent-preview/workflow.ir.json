{
  "irVersion":1,
  "name":"comfy-workflow-h3-latent-preview",
  "nodes":{
    "1":{
      "type":"GemmyH3LoadAVLatent",
      "params":{
        "path":{
          "$param":"context_latent"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"GemmyH3SplitAV",
      "params":{},
      "inputs":{
        "samples":{
          "node":"1",
          "out":0
        }
      }
    },
    "3":{
      "type":"MinimaxH3LatentUpscaler3D",
      "params":{
        "model_name":{
          "$param":"upscale_model"
        },
        "mode":{
          "$param":"mode"
        },
        "align":32,
        "keep_proportion":true,
        "device":"cuda",
        "precision":"fp16",
        "mode.scale":{
          "$param":"scale"
        },
        "mode.width":{
          "$param":"target_width"
        },
        "mode.height":{
          "$param":"target_height"
        }
      },
      "inputs":{
        "latent":{
          "node":"2",
          "out":0
        }
      }
    },
    "4":{
      "type":"GemmyH3JoinAV",
      "params":{},
      "inputs":{
        "video":{
          "node":"3",
          "out":0
        },
        "audio":{
          "node":"2",
          "out":1
        }
      }
    },
    "5":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "6":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"audio_vae"
        }
      },
      "inputs":{}
    },
    "7":{
      "type":"VAEDecode",
      "params":{},
      "inputs":{
        "samples":{
          "node":"4",
          "out":0
        },
        "vae":{
          "node":"5",
          "out":0
        }
      }
    },
    "8":{
      "type":"VAEDecodeAudio",
      "params":{},
      "inputs":{
        "samples":{
          "node":"4",
          "out":0
        },
        "vae":{
          "node":"6",
          "out":0
        }
      }
    },
    "9":{
      "type":"CreateVideo",
      "params":{
        "fps":24
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        },
        "audio":{
          "node":"8",
          "out":0
        }
      }
    },
    "10":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"output_prefix"
        },
        "format":"auto",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"9",
          "out":0
        }
      }
    },
    "11":{
      "type":"GemmyH3SaveAVLatent",
      "params":{
        "filename_prefix":{
          "$param":"latent_prefix"
        },
        "fingerprint":{
          "$param":"fingerprint"
        }
      },
      "inputs":{
        "samples":{
          "node":"4",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"10",
      "out":0
    },
    {
      "node":"11",
      "out":0
    }
  ],
  "params":{
    "context_latent":{
      "name":"context_latent",
      "type":"string"
    },
    "upscale_model":{
      "name":"upscale_model",
      "type":"string",
      "default":"minimax_h3_latent_upscaler_3d_fp16.safetensors"
    },
    "scale":{
      "name":"scale",
      "type":"int",
      "default":2
    },
    "mode":{
      "name":"mode",
      "type":"string",
      "default":"scale by multiplier"
    },
    "target_width":{
      "name":"target_width",
      "type":"int",
      "default":1280
    },
    "target_height":{
      "name":"target_height",
      "type":"int",
      "default":720
    },
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae":{
      "name":"audio_vae",
      "type":"string",
      "default":"minimax_h3_audio_vae_fp32.safetensors"
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/latent_up"
    },
    "latent_prefix":{
      "name":"latent_prefix",
      "type":"string",
      "default":"h3/latent_up"
    },
    "fingerprint":{
      "name":"fingerprint",
      "type":"string",
      "default":"{}"
    }
  }
}
