{
  "specVersion": 1,
  "name": "comfy-workflow-h3-ganloss-stage1-vsa",
  "title": "Eros stage 1 + VSA",
  "entry": "./workflow.ir.json",
  "description": "Crop-video Eros SplitSigmas@4 with Ref2VAVSAGatePatch. Opt-in --vsa.",
  "parameters": {
    "unet": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
    },
    "clip": {
      "type": "string",
      "required": false,
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "width": {
      "type": "int",
      "required": false,
      "default": 512
    },
    "height": {
      "type": "int",
      "required": false,
      "default": 288
    },
    "length": {
      "type": "int",
      "required": false,
      "default": 124
    },
    "seed": {
      "type": "int",
      "required": false,
      "default": 42
    },
    "steps": {
      "type": "int",
      "required": false,
      "default": 8
    },
    "shift_video": {
      "type": "int",
      "required": false,
      "default": 12
    },
    "shift_audio": {
      "type": "int",
      "required": false,
      "default": 3
    },
    "ref_image": {
      "type": "string",
      "required": true
    },
    "latent_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ganloss_s1_av"
    },
    "fingerprint": {
      "type": "string",
      "required": false,
      "default": "{}"
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ganloss_s1"
    },
    "gate_file": {
      "type": "string",
      "required": false,
      "default": "fasth3_vsa_gate.safetensors"
    },
    "sparsity": {
      "type": "float",
      "required": false,
      "default": 0.75
    },
    "crop_video": {
      "type": "string",
      "required": true
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    },
    {
      "name": "output-1",
      "type": "IMAGE"
    },
    {
      "name": "output-2",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "BasicGuider",
      "BasicScheduler",
      "CLIPLoader",
      "ConditioningZeroOut",
      "CreateVideo",
      "GemmyH3SaveAVLatent",
      "GetVideoComponents",
      "KSamplerSelect",
      "LoadImage",
      "LoadVideo",
      "MiniMaxH3ReferenceToVideo",
      "MiniMaxH3SigmaShift",
      "RandomNoise",
      "Ref2VAVSAGatePatch",
      "SamplerCustomAdvanced",
      "SaveVideo",
      "SplitSigmas",
      "UNETLoader",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
      },
      {
        "kind": "model",
        "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
