      "inputs":{
        "samples":{
          "node":"8e",
          "out":0
        }
      }
    },
    "10":{
      "type":"VAEDecode",
      "params":{},
      "inputs":{
        "samples":{
          "node":"8e",
          "out":0
        },
        "vae":{
          "node":"3",
          "out":0
        }
      }
    },
    "11":{
      "type":"VAEDecodeAudio",
      "params":{},
      "inputs":{
        "samples":{
          "node":"8e",
          "out":0
