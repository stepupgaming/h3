{
  "irVersion":1,
  "name":"comfy-workflow-h3-pixelforge",
  "nodes":{
    "1":{
      "type":"LoadVideo",
      "params":{
        "file":{
          "$param":"video"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"PixelForgeVideoToFrames",
      "params":{
        "every_nth":{
          "$param":"every_nth"
        },
        "start_offset":{
          "$param":"start_offset"
        },
        "max_frames":{
          "$param":"max_frames"
        }
      },
      "inputs":{
        "video":{
          "node":"1",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "IMAGE",
        "FLOAT",
        "STRING"
      ],
      "outputNames":[
        "images",
        "fps_effective",
        "info"
      ]
    },
    "3":{
      "type":"PixelForgeChromaKey",
      "params":{
        "key_color":{
          "$param":"key_color"
        },
        "tolerance":0.25,
        "softness":0,
        "despill":true,
        "method":"flood",
        "shadow_tolerance":1,
        "key_interior":true,
        "interior_tolerance":0.5,
        "matte_erode":1,
        "subject_rescue":true,
        "interior_max_area":2,
        "temporal_alpha":true,
        "drop_detached":5
      },
      "inputs":{
        "images":{
          "node":"2",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "IMAGE",
        "MASK"
      ],
      "outputNames":[
        "images",
        "alpha"
      ]
    },
    "5":{
      "type":"PixelForgeAutoCrop",
      "params":{
        "bbox_mode":"union",
        "anchor":"bottom_center",
        "padding":8,
        "size_multiple":8,
        "out_size":0,
        "canvas_mode":"content",
        "canvas_width":200,
        "canvas_height":200,
        "placement":"bottom_center",
        "offset_x":0,
        "offset_y":0
      },
      "inputs":{
        "images":{
          "node":"3",
          "out":0
        },
        "alpha":{
          "node":"3",
          "out":1
        }
      },
      "raw":1,
      "outputTypes":[
        "IMAGE",
        "MASK",
        "STRING"
      ],
      "outputNames":[
        "images",
        "alpha",
        "crop_info"
      ]
    },
    "6":{
      "type":"PixelForgeLoopTrim",
      "params":{
        "mode":{
          "$param":"loop_mode"
        },
        "max_loop_error":0.06,
        "search_tail_fraction":0.5
      },
      "inputs":{
        "images":{
          "node":"5",
          "out":0
        },
        "alpha":{
          "node":"5",
          "out":1
        }
      },
      "raw":1,
      "outputTypes":[
        "IMAGE",
        "MASK",
        "STRING"
      ],
      "outputNames":[
        "images",
        "alpha",
        "report"
      ]
    },
    "7":{
      "type":"PixelForgeFrameDedup",
      "params":{
        "threshold":0.01
      },
      "inputs":{
        "images":{
          "node":"6",
          "out":0
        },
        "alpha":{
          "node":"6",
          "out":1
        }
      },
      "raw":1,
      "outputTypes":[
        "IMAGE",
        "MASK",
        "STRING"
      ],
      "outputNames":[
        "images",
        "alpha",
        "durations_json"
      ]
    },
    "8":{
      "type":"PixelForgeSheetPack",
      "params":{
        "columns":0,
        "padding":0,
        "bg_color":"#000000",
        "fps_for_durations":{
          "$param":"fps"
        }
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        },
        "alpha":{
          "node":"7",
          "out":1
        },
        "durations_json":{
          "node":"7",
          "out":2
        }
      },
      "raw":1,
      "outputTypes":[
        "IMAGE",
        "MASK",
        "STRING"
      ],
      "outputNames":[
        "sheet",
        "sheet_alpha",
        "sheet_json"
      ]
    },
    "9":{
      "type":"PixelForgeAsepriteExport",
      "params":{
        "filename_prefix":{
          "$param":"filename_prefix"
        },
        "tag_name":{
          "$param":"tag_name"
        },
        "fps":{
          "$param":"fps"
        },
        "build_aseprite":false,
        "aseprite_path":""
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        },
        "alpha":{
          "node":"7",
          "out":1
        },
        "durations_json":{
          "node":"7",
          "out":2
        }
      },
      "raw":1,
      "outputTypes":[
        "STRING"
      ],
      "outputNames":[
        "report"
      ]
    },
    "10":{
      "type":"PixelForgeSaveGIF",
      "params":{
        "filename_prefix":{
          "$param":"gif_prefix"
        },
        "fps":{
          "$param":"fps"
        },
        "loop":true,
        "upscale":1,
        "preview_webp":true
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        },
        "alpha":{
          "node":"7",
          "out":1
        },
        "durations_json":{
          "node":"7",
          "out":2
        }
      },
      "raw":1,
      "outputTypes":[
        "STRING"
      ],
      "outputNames":[
        "report"
      ]
    },
    "11":{
      "type":"SaveImage",
      "params":{
        "filename_prefix":{
          "$param":"sheet_prefix"
        }
      },
      "inputs":{
        "images":{
          "node":"8",
          "out":0
        }
      }
    },
    "12":{
      "type":"SaveAnimatedWEBP",
      "params":{
        "filename_prefix":{
          "$param":"webp_prefix"
        },
        "fps":{
          "$param":"fps"
        },
        "lossless":true,
        "quality":80,
        "method":"default"
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"11",
      "out":0
    },
    {
      "node":"12",
      "out":0
    },
    {
      "node":"9",
      "out":0
    },
    {
      "node":"10",
      "out":0
    }
  ],
  "params":{
    "video":{
      "name":"video",
      "type":"combo"
    },
    "every_nth":{
      "name":"every_nth",
      "type":"int",
      "default":2
    },
    "start_offset":{
      "name":"start_offset",
      "type":"int",
      "default":0
    },
    "max_frames":{
      "name":"max_frames",
      "type":"int",
      "default":0
    },
    "key_color":{
      "name":"key_color",
      "type":"string",
      "default":"auto"
    },
    "loop_mode":{
      "name":"loop_mode",
      "type":"string",
      "default":"off"
    },
    "filename_prefix":{
      "name":"filename_prefix",
      "type":"string",
      "default":"gemmy/pixelforge/sprite"
    },
    "sheet_prefix":{
      "name":"sheet_prefix",
      "type":"string",
      "default":"gemmy/pixelforge/sheet"
    },
    "gif_prefix":{
      "name":"gif_prefix",
      "type":"string",
      "default":"gemmy/pixelforge/gif"
    },
    "webp_prefix":{
      "name":"webp_prefix",
      "type":"string",
      "default":"gemmy/pixelforge/preview"
    },
    "tag_name":{
      "name":"tag_name",
      "type":"string",
      "default":"run"
    },
    "fps":{
      "name":"fps",
      "type":"float",
      "default":12
    }
  }
}
