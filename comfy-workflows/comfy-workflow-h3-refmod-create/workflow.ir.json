{
  "irVersion":1,
  "name":"comfy-workflow-h3-refmod-create",
  "nodes":{
    "1":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"MiniMaxH3RefModFolderLoader",
      "params":{
        "folder":{
          "$param":"folder"
        },
        "max_items":{
          "$param":"max_items"
        },
        "max_frames":{
          "$param":"max_frames"
        },
        "max_edge":1024
      },
      "inputs":{},
      "raw":1,
      "outputTypes":[
        "H3_REF_LIST",
        "INT"
      ],
      "outputNames":[
        "refs",
        "count"
      ]
    },
    "3":{
      "type":"MiniMaxH3RefModExtract",
      "params":{
        "name":{
          "$param":"name"
        },
        "mode":{
          "$param":"mode"
        },
        "concept_type":{
          "$param":"concept_type"
        },
        "background_retention":0,
        "ref_resolution":{
          "$param":"ref_resolution"
        },
        "pool_h":16,
        "pool_w":16,
        "latent_frames":16,
        "identity":0,
        "merge":false,
        "motion_only":false,
        "multiplier":1,
        "max_tokens":{
          "$param":"max_tokens"
        },
        "extraction_preset":"manual",
        "subfolder":{
          "$param":"subfolder"
        },
        "description":{
          "$param":"description"
        },
        "save":false,
        "budget_policy":"error"
      },
      "inputs":{
        "refs_bundle":{
          "node":"2",
          "out":0
        },
        "vae":{
          "node":"1",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "H3_REF_MODS"
      ],
      "outputNames":[
        "mods"
      ]
    },
    "4":{
      "type":"MiniMaxH3RefModSave",
      "params":{
        "filename_prefix":"",
        "subfolder":{
          "$param":"subfolder"
        }
      },
      "inputs":{
        "mods":{
          "node":"3",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "H3_REF_MODS",
        "STRING"
      ],
      "outputNames":[
        "mods",
        "saved_paths"
      ]
    }
  },
  "outputs":[
    {
      "node":"4",
      "out":1
    }
  ],
  "params":{
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "folder":{
      "name":"folder",
      "type":"string"
    },
    "name":{
      "name":"name",
      "type":"string",
      "default":"character"
    },
    "mode":{
      "name":"mode",
      "type":"string",
      "default":"Full Reference"
    },
    "concept_type":{
      "name":"concept_type",
      "type":"string",
      "default":"identity"
    },
    "ref_resolution":{
      "name":"ref_resolution",
      "type":"int",
      "default":1024
    },
    "max_tokens":{
      "name":"max_tokens",
      "type":"int",
      "default":8192
    },
    "max_items":{
      "name":"max_items",
      "type":"int",
      "default":32
    },
    "max_frames":{
      "name":"max_frames",
      "type":"int",
      "default":240
    },
    "subfolder":{
      "name":"subfolder",
      "type":"string",
      "default":""
    },
    "description":{
      "name":"description",
      "type":"string",
      "default":""
    }
  }
}
