{
  "specVersion": 1,
  "name": "comfy-workflow-h3-latent-preview",
  "title": "H3 Latent Upscale Preview",
  "entry": "./workflow.ir.json",
  "description": "3D latent upscale then decode only (no second H3 sample).",
  "parameters": {
    "context_latent": {
      "type": "string",
      "required": true
    },
    "upscale_model": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
    },
    "scale": {
      "type": "int",
      "required": false,
      "default": 2
    },
    "mode": {
      "type": "string",
      "required": false,
      "default": "scale by multiplier"
    },
    "target_width": {
      "type": "int",
      "required": false,
      "default": 1280
    },
    "target_height": {
      "type": "int",
      "required": false,
      "default": 720
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/latent_up"
    },
    "latent_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/latent_up"
    },
    "fingerprint": {
      "type": "string",
      "required": false,
      "default": "{}"
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    },
    {
      "name": "output-1",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "CreateVideo",
      "GemmyH3JoinAV",
      "GemmyH3LoadAVLatent",
      "GemmyH3SaveAVLatent",
      "GemmyH3SplitAV",
      "MinimaxH3LatentUpscaler3D",
      "SaveVideo",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [
      "gemmy-h3-context",
      "Comfyui_Minimax_h3_latent_Upscaler"
    ],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
