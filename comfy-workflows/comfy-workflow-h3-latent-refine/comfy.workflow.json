{
  "specVersion": 1,
  "name": "comfy-workflow-h3-latent-refine",
  "title": "H3 Latent Upscale + Refine",
  "entry": "./workflow.ir.json",
  "description": "3D latent upscale then a short H3 refine sample. Gemmy `video h3 upscale --backend latent`.",
  "parameters": {
    "unet": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_fl2va_pruned_int8_convrot.safetensors"
    },
    "clip": {
      "type": "string",
      "required": false,
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "width": {
      "type": "int",
      "required": false,
      "default": 1280
    },
    "height": {
      "type": "int",
      "required": false,
      "default": 720
    },
    "length": {
      "type": "int",
      "required": false,
      "default": 124
    },
    "context_latent": {
      "type": "string",
      "required": true
    },
    "upscale_model": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
    },
    "seed": {
      "type": "int",
      "required": false,
      "default": 42
    },
    "shift_video": {
      "type": "int",
      "required": false,
      "default": 12
    },
    "shift_audio": {
      "type": "int",
      "required": false,
      "default": 3
    },
    "latent_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/latent_refine_av"
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/latent_refine"
    },
    "fingerprint": {
      "type": "string",
      "required": false,
      "default": "{}"
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    },
    {
      "name": "output-1",
      "type": "IMAGE"
    },
    {
      "name": "output-2",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "BasicGuider",
      "CLIPLoader",
      "ConditioningZeroOut",
      "CreateVideo",
      "GemmyH3JoinAV",
      "GemmyH3LoadAVLatent",
      "GemmyH3SaveAVLatent",
      "GemmyH3SplitAV",
      "KSamplerSelect",
      "ManualSigmas",
      "MiniMaxH3ImageToVideo",
      "MiniMaxH3SigmaShift",
      "MinimaxH3LatentUpscaler3D",
      "RandomNoise",
      "SamplerCustomAdvanced",
      "SaveVideo",
      "UNETLoader",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [
      "gemmy-h3-context",
      "Comfyui_Minimax_h3_latent_Upscaler"
    ],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors"
      },
      {
        "kind": "model",
        "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
