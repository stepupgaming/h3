# Directory containing ComfyUI/main.py. The default is ../ComfyUI.
H3_COMFY_ROOT=/path/to/ComfyUI
H3_COMFY_URL=http://127.0.0.1:8188

# Persistent voices, anchors, jobs, and reports. The default is
# ~/.local/share/minimax-h3-voice-api.
# H3_DATA_DIR=/path/to/minimax-h3-data

# Optional existing onnx-asr Parakeet directory. If omitted, onnx-asr downloads
# its CPU int8 model into the normal user cache on first verification.
# H3_PARAKEET_MODEL=/path/to/parakeet-int8
# Upload safety limits for POST /v1/audio/transcriptions.
H3_MAX_TRANSCRIPTION_MB=250
H3_MAX_TRANSCRIPTION_SECONDS=3600

H3_API_HOST=0.0.0.0
H3_API_PORT=8787

# Override these only if your ComfyUI model filenames differ.
H3_MODEL_T2VA=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_MODEL_REF2VA=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_MODEL_REF2VA_EROS=10Eros_Max_h3_TURBO_ref2va_beta2_int8_convrot.safetensors
H3_MODEL_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_MODEL_VIDEO_VAE=minimax_h3_video_vae_int8_convrot.safetensors
H3_MODEL_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
