{
  "specVersion": 1,
  "name": "comfy-workflow-h3-ganloss-stage2-still",
  "title": "Eros still-only stage 2",
  "entry": "./workflow.ir.json",
  "description": "Refine the Eros working AV latent at the requested width and height with the same reference still.",
  "parameters": {
    "unet": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
    },
    "clip": {
      "type": "string",
      "required": false,
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "width": {
      "type": "int",
      "required": false,
      "default": 864
    },
    "height": {
      "type": "int",
      "required": false,
      "default": 480
    },
    "length": {
      "type": "int",
      "required": false,
      "default": 124
    },
    "seed": {
      "type": "int",
      "required": false,
      "default": 42
    },
    "shift_video": {
      "type": "int",
      "required": false,
      "default": 12
    },
    "shift_audio": {
      "type": "int",
      "required": false,
      "default": 3
    },
    "ref_image": {
      "type": "string",
      "required": true
    },
    "context_latent": {
      "type": "string",
      "required": true
    },
    "upscale_model": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ganloss_s2"
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    },
    {
      "name": "output-1",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "BasicGuider",
      "CLIPLoader",
      "ConditioningZeroOut",
      "CreateVideo",
      "GemmyH3JoinAV",
      "GemmyH3LoadAVLatent",
      "GemmyH3SplitAV",
      "KSamplerSelect",
      "LoadImage",
      "ManualSigmas",
      "MiniMaxH3ReferenceToVideo",
      "MiniMaxH3SigmaShift",
      "MinimaxH3LatentUpscaler3D",
      "RandomNoise",
      "SamplerCustomAdvanced",
      "SaveVideo",
      "UNETLoader",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_latent_upscaler_3d_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
