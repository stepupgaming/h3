{
  "irVersion":1,
  "name":"comfy-workflow-h3-t2va-spectrum",
  "nodes":{
    "1":{
      "type":"UNETLoader",
      "params":{
        "unet_name":{
          "$param":"unet"
        },
        "weight_dtype":"default"
      },
      "inputs":{}
    },
    "2":{
      "type":"CLIPLoader",
      "params":{
        "clip_name":{
          "$param":"clip"
        },
        "type":"minimax",
        "device":"cpu"
      },
      "inputs":{}
    },
    "3":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "4":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"audio_vae"
        }
      },
      "inputs":{}
    },
    "5":{
      "type":"SpectrumApplyMiniMaxH3",
      "params":{
        "enabled":true,
        "blend_weight":0.5,
        "degree":1,
        "ridge_lambda":0.1,
        "window_size":2,
        "flex_window":0.75,
        "warmup_steps":1,
        "tail_actual_steps":1,
        "max_history":8,
        "debug":false,
        "history_storage":"system_ram",
        "bootstrap_first_forecast":true,
        "anchor_residual_feedback":false,
        "selective_rollback_correction":false,
        "offline_smoothing_replay":true,
        "audio_blend_weight":0,
        "offline_archive_storage":"system_ram"
      },
      "inputs":{
        "model":{
          "node":"1",
          "out":0
        }
      }
    },
    "6":{
      "type":"MiniMaxH3SigmaShift",
      "params":{
        "shift_video":{
          "$param":"shift_video"
        },
        "shift_audio":{
          "$param":"shift_audio"
        }
      },
      "inputs":{
        "model":{
          "node":"5",
          "out":0
        }
      }
    },
    "7":{
      "type":"MiniMaxH3ImageToVideo",
      "params":{
        "prompt":{
          "$param":"prompt"
        },
        "width":{
          "$param":"width"
        },
        "height":{
          "$param":"height"
        },
        "length":{
          "$param":"length"
        }
      },
      "inputs":{
        "clip":{
          "node":"2",
          "out":0
        },
        "vae":{
          "node":"3",
          "out":0
        }
      }
    },
    "8":{
      "type":"ConditioningZeroOut",
      "params":{},
      "inputs":{
        "conditioning":{
          "node":"7",
          "out":0
        }
      }
    },
    "9":{
      "type":"KSampler",
      "params":{
        "seed":{
          "$param":"seed"
        },
        "steps":{
          "$param":"steps"
        },
        "cfg":1,
        "sampler_name":"euler",
        "scheduler":"simple",
        "denoise":{
          "$param":"denoise"
        }
      },
      "inputs":{
        "model":{
          "node":"6",
          "out":0
        },
        "positive":{
          "node":"7",
          "out":0
        },
        "negative":{
          "node":"8",
          "out":0
        },
        "latent_image":{
          "node":"7",
          "out":1
        }
      }
    },
    "10":{
      "type":"GemmyH3SaveAVLatent",
      "params":{
        "filename_prefix":{
          "$param":"latent_prefix"
        },
        "fingerprint":{
          "$param":"fingerprint"
        }
      },
      "inputs":{
        "samples":{
          "node":"9",
          "out":0
        }
      }
    },
    "11":{
      "type":"VAEDecode",
      "params":{},
      "inputs":{
        "samples":{
          "node":"9",
          "out":0
        },
        "vae":{
          "node":"3",
          "out":0
        }
      }
    },
    "12":{
      "type":"VAEDecodeAudio",
      "params":{},
      "inputs":{
        "samples":{
          "node":"9",
          "out":0
        },
        "vae":{
          "node":"4",
          "out":0
        }
      }
    },
    "13":{
      "type":"CreateVideo",
      "params":{
        "fps":24
      },
      "inputs":{
        "images":{
          "node":"11",
          "out":0
        },
        "audio":{
          "node":"12",
          "out":0
        }
      }
    },
    "14":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"output_prefix"
        },
        "format":"auto",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"13",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"10",
      "out":0
    },
    {
      "node":"14",
      "out":0
    }
  ],
  "params":{
    "unet":{
      "name":"unet",
      "type":"string",
      "default":"minimax_h3_fl2va_pruned_int8_convrot.safetensors"
    },
    "clip":{
      "name":"clip",
      "type":"string",
      "default":"qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae":{
      "name":"audio_vae",
      "type":"string",
      "default":"minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt":{
      "name":"prompt",
      "type":"string"
    },
    "width":{
      "name":"width",
      "type":"int",
      "default":864
    },
    "height":{
      "name":"height",
      "type":"int",
      "default":480
    },
    "length":{
      "name":"length",
      "type":"int",
      "default":124
    },
    "seed":{
      "name":"seed",
      "type":"int",
      "default":42
    },
    "steps":{
      "name":"steps",
      "type":"int",
      "default":20
    },
    "denoise":{
      "name":"denoise",
      "type":"float",
      "default":1
    },
    "shift_video":{
      "name":"shift_video",
      "type":"int",
      "default":12
    },
    "shift_audio":{
      "name":"shift_audio",
      "type":"int",
      "default":3
    },
    "latent_prefix":{
      "name":"latent_prefix",
      "type":"string",
      "default":"h3/t2va_spectrum_av"
    },
    "fingerprint":{
      "name":"fingerprint",
      "type":"string",
      "default":"{}"
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/t2va_spectrum"
    }
  }
}
