{
  "irVersion":1,
  "name":"comfy-workflow-h3-rtx-vsr",
  "nodes":{
    "1":{
      "type":"RTXVideoSuperResolution",
      "params":{
        "quality":{
          "$param":"quality"
        },
        "resize_type":{
          "$param":"resize_type"
        },
        "resize_type.scale":{
          "$param":"scale"
        },
        "resize_type.width":{
          "$param":"target_width"
        },
        "resize_type.height":{
          "$param":"target_height"
        },
        "resize_type.keep_aspect_ratio":{
          "$param":"keep_aspect"
        }
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        }
      }
    },
    "6":{
      "type":"LoadVideo",
      "params":{
        "file":{
          "$param":"video"
        }
      },
      "inputs":{}
    },
    "7":{
      "type":"GetVideoComponents",
      "params":{},
      "inputs":{
        "video":{
          "node":"6",
          "out":0
        }
      }
    },
    "8":{
      "type":"CreateVideo",
      "params":{},
      "inputs":{
        "images":{
          "node":"1",
          "out":0
        },
        "fps":{
          "node":"7",
          "out":2
        },
        "audio":{
          "node":"7",
          "out":1
        }
      }
    },
    "9":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"output_prefix"
        },
        "format":"auto",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"8",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"9",
      "out":0
    }
  ],
  "params":{
    "video":{
      "name":"video",
      "type":"string"
    },
    "quality":{
      "name":"quality",
      "type":"string",
      "default":"HIGH"
    },
    "scale":{
      "name":"scale",
      "type":"int",
      "default":2
    },
    "resize_type":{
      "name":"resize_type",
      "type":"string",
      "default":"scale by multiplier"
    },
    "target_width":{
      "name":"target_width",
      "type":"int",
      "default":1920
    },
    "target_height":{
      "name":"target_height",
      "type":"int",
      "default":1088
    },
    "keep_aspect":{
      "name":"keep_aspect",
      "type":"boolean",
      "default":false
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/rtx_vsr"
    }
  }
}
