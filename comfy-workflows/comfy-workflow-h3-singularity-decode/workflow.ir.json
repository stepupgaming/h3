{
  "irVersion":1,
  "name":"comfy-workflow-h3-singularity-decode",
  "nodes":{
    "1":{
      "type":"GemmyH3LoadAVLatent",
      "params":{
        "path":{
          "$param":"latent_path"
        }
      },
      "inputs":{},
      "raw":1,
      "outputTypes":[
        "LATENT",
        "STRING"
      ],
      "outputNames":[
        "latent",
        "fingerprint"
      ]
    },
    "2":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "3":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"audio_vae"
        }
      },
      "inputs":{}
    },
    "4":{
      "type":"VAEDecode",
      "params":{},
      "inputs":{
        "samples":{
          "node":"1",
          "out":0
        },
        "vae":{
          "node":"2",
          "out":0
        }
      }
    },
    "5":{
      "type":"VAEDecodeAudio",
      "params":{},
      "inputs":{
        "samples":{
          "node":"1",
          "out":0
        },
        "vae":{
          "node":"3",
          "out":0
        }
      }
    },
    "6":{
      "type":"CreateVideo",
      "params":{
        "fps":24
      },
      "inputs":{
        "images":{
          "node":"4",
          "out":0
        },
        "audio":{
          "node":"5",
          "out":0
        }
      }
    },
    "7":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"output_prefix"
        },
        "format":"auto",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"6",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"7",
      "out":0
    }
  ],
  "params":{
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae":{
      "name":"audio_vae",
      "type":"string",
      "default":"minimax_h3_audio_vae_fp32.safetensors"
    },
    "latent_path":{
      "name":"latent_path",
      "type":"string"
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/singularity_dual"
    }
  }
}
