{
  "specVersion": 1,
  "name": "comfy-workflow-h3-singularity-encode",
  "title": "H3 Singularity encode",
  "entry": "./workflow.ir.json",
  "description": "Singularity process 1: text encoder and VAEs only. Exits before the UNET loads.",
  "parameters": {
    "clip": {
      "type": "string",
      "required": false,
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "width": {
      "type": "int",
      "required": false,
      "default": 544
    },
    "height": {
      "type": "int",
      "required": false,
      "default": 960
    },
    "length": {
      "type": "int",
      "required": false,
      "default": 124
    },
    "ref_image": {
      "type": "string",
      "required": true
    },
    "cond_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/singularity_cond"
    },
    "latent_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/singularity_empty"
    },
    "fingerprint": {
      "type": "string",
      "required": false,
      "default": "{}"
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "STRING"
    },
    {
      "name": "output-1",
      "type": "STRING"
    }
  ],
  "requires": {
    "nodeClasses": [
      "CLIPLoader",
      "GemmyH3SaveAVLatent",
      "GemmyH3SaveConditioning",
      "LoadImage",
      "MiniMaxH3ReferenceToVideo",
      "VAELoader"
    ],
    "nodePacks": [
      "gemmy-h3-context"
    ],
    "models": [
      {
        "kind": "model",
        "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
