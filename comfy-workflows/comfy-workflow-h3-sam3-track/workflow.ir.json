{
  "irVersion":1,
  "name":"comfy-workflow-h3-sam3-track",
  "nodes":{
    "1":{
      "type":"LoadVideo",
      "params":{
        "file":{
          "$param":"video"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"GetVideoComponents",
      "params":{},
      "inputs":{
        "video":{
          "node":"1",
          "out":0
        }
      }
    },
    "3":{
      "type":"CheckpointLoaderSimple",
      "params":{
        "ckpt_name":{
          "$param":"checkpoint"
        }
      },
      "inputs":{}
    },
    "4":{
      "type":"CLIPTextEncode",
      "params":{
        "text":{
          "$param":"prompt"
        }
      },
      "inputs":{
        "clip":{
          "node":"3",
          "out":1
        }
      }
    },
    "5":{
      "type":"SAM3_VideoTrack",
      "params":{
        "detection_threshold":0.5,
        "max_objects":1,
        "detect_interval":1
      },
      "inputs":{
        "images":{
          "node":"2",
          "out":0
        },
        "model":{
          "node":"3",
          "out":0
        },
        "conditioning":{
          "node":"4",
          "out":0
        }
      }
    },
    "6":{
      "type":"SAM3_TrackToMask",
      "params":{
        "object_indices":"0"
      },
      "inputs":{
        "track_data":{
          "node":"5",
          "out":0
        }
      }
    },
    "7":{
      "type":"MaskToImage",
      "params":{},
      "inputs":{
        "mask":{
          "node":"6",
          "out":0
        }
      }
    },
    "8":{
      "type":"CreateVideo",
      "params":{
        "fps":24
      },
      "inputs":{
        "images":{
          "node":"7",
          "out":0
        }
      }
    },
    "9":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"output_prefix"
        },
        "format":"auto",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"8",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"9",
      "out":0
    }
  ],
  "params":{
    "video":{
      "name":"video",
      "type":"string"
    },
    "checkpoint":{
      "name":"checkpoint",
      "type":"combo",
      "default":"sam3.1_multiplex_fp16.safetensors"
    },
    "prompt":{
      "name":"prompt",
      "type":"string"
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/sam3"
    }
  }
}
