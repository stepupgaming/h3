{
  "irVersion":1,
  "name":"comfy-workflow-h3-dlss-interpolate",
  "nodes":{
    "1":{
      "type":"LoadVideo",
      "params":{
        "file":{
          "$param":"video"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"NvidiaDLSSFrameInterpolation",
      "params":{
        "output_fps":{
          "$param":"output_fps"
        },
        "dlss_engine":{
          "$param":"dlss_engine"
        },
        "encoding_quality":{
          "$param":"encoding_quality"
        },
        "video_codec":{
          "$param":"video_codec"
        },
        "container":{
          "$param":"container"
        },
        "rename":"Auto",
        "custom_suffix":"_DLSSFG",
        "hdr_mode":false
      },
      "inputs":{
        "video":{
          "node":"1",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "VIDEO",
        "STRING"
      ],
      "outputNames":[
        "video",
        "report"
      ]
    },
    "3":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"filename_prefix"
        },
        "format":"mp4",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"2",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"3",
      "out":0
    },
    {
      "node":"2",
      "out":1
    }
  ],
  "params":{
    "video":{
      "name":"video",
      "type":"combo"
    },
    "output_fps":{
      "name":"output_fps",
      "type":"string",
      "default":"48"
    },
    "dlss_engine":{
      "name":"dlss_engine",
      "type":"string",
      "default":"Auto"
    },
    "encoding_quality":{
      "name":"encoding_quality",
      "type":"string",
      "default":"Max"
    },
    "video_codec":{
      "name":"video_codec",
      "type":"string",
      "default":"H.264"
    },
    "container":{
      "name":"container",
      "type":"string",
      "default":"MP4"
    },
    "filename_prefix":{
      "name":"filename_prefix",
      "type":"string",
      "default":"gemmy/dlss/interpolate"
    }
  }
}
