    "denoise":{
      "name":"denoise",
      "type":"float",
      "default":1
    },
    "shift_video":{
      "name":"shift_video",
      "type":"int",
      "default":12
    },
    "shift_audio":{
      "name":"shift_audio",
      "type":"int",
      "default":3
    },
    "latent_prefix":{
      "name":"latent_prefix",
      "type":"string",
      "default":"h3/t2va_av"
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/t2va"
    },
    "fingerprint":{
      "name":"fingerprint",
      "type":"string",
      "default":"{}"
    },
    "sdk_python":{
      "name":"sdk_python",
      "type":"string",
      "default":""
    },
    "initial_policy":{
      "name":"initial_policy",
      "type":"string",
      "default":"jev_first"
    }
  }
