{
  "specVersion": 1,
  "name": "comfy-workflow-h3-ref2va-refmod",
  "title": "H3 Reference to Video-Audio + RefMod",
  "entry": "./workflow.ir.json",
  "description": "Live still plus saved RefMods (Apply). Gemmy `video h3 generate --mode ref2va --ref-mod --weights`. Product Eros two-stage uses the ganloss still-refmod packages.",
  "parameters": {
    "unet": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
    },
    "clip": {
      "type": "string",
      "required": false,
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "ref_image": {
      "type": "string",
      "required": true
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "width": {
      "type": "int",
      "required": false,
      "default": 864
    },
    "height": {
      "type": "int",
      "required": false,
      "default": 480
    },
    "length": {
      "type": "int",
      "required": false,
      "default": 124
    },
    "seed": {
      "type": "int",
      "required": false,
      "default": 42
    },
    "steps": {
      "type": "int",
      "required": false,
      "default": 20
    },
    "denoise": {
      "type": "float",
      "required": false,
      "default": 1
    },
    "shift_video": {
      "type": "int",
      "required": false,
      "default": 12
    },
    "shift_audio": {
      "type": "int",
      "required": false,
      "default": 3
    },
    "latent_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ref2va_av"
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ref2va"
    },
    "fingerprint": {
      "type": "string",
      "required": false,
      "default": "{}"
    },
    "refmod_1": {
      "type": "string",
      "required": false,
      "default": "(none)"
    },
    "refmod_strength_1": {
      "type": "float",
      "required": false,
      "default": 1
    },
    "refmod_copies_1": {
      "type": "int",
      "required": false,
      "default": 1
    },
    "refmod_2": {
      "type": "string",
      "required": false,
      "default": "(none)"
    },
    "refmod_strength_2": {
      "type": "float",
      "required": false,
      "default": 1
    },
    "refmod_copies_2": {
      "type": "int",
      "required": false,
      "default": 1
    },
    "refmod_3": {
      "type": "string",
      "required": false,
      "default": "(none)"
    },
    "refmod_strength_3": {
      "type": "float",
      "required": false,
      "default": 1
    },
    "refmod_copies_3": {
      "type": "int",
      "required": false,
      "default": 1
    },
    "refmod_4": {
      "type": "string",
      "required": false,
      "default": "(none)"
    },
    "refmod_strength_4": {
      "type": "float",
      "required": false,
      "default": 1
    },
    "refmod_copies_4": {
      "type": "int",
      "required": false,
      "default": 1
    },
    "refmod_retention": {
      "type": "float",
      "required": false,
      "default": 1
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    },
    {
      "name": "output-1",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "CLIPLoader",
      "ConditioningZeroOut",
      "CreateVideo",
      "GemmyH3SaveAVLatent",
      "KSampler",
      "LoadImage",
      "MiniMaxH3RefModApply",
      "MiniMaxH3RefModsLoader",
      "MiniMaxH3ReferenceToVideo",
      "MiniMaxH3SigmaShift",
      "SaveVideo",
      "UNETLoader",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [
      "ComfyUI-MiniMaxH3Mod"
    ],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
      },
      {
        "kind": "model",
        "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
