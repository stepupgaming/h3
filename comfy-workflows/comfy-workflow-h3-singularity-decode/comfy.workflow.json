{
  "specVersion": 1,
  "name": "comfy-workflow-h3-singularity-decode",
  "title": "H3 Singularity decode",
  "entry": "./workflow.ir.json",
  "description": "Singularity process 4: video and audio VAE decode. No UNET.",
  "parameters": {
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "latent_path": {
      "type": "string",
      "required": true
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/singularity_dual"
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "CreateVideo",
      "GemmyH3LoadAVLatent",
      "SaveVideo",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [
      "gemmy-h3-context"
    ],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
