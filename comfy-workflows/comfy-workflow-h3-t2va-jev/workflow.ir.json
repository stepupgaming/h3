      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae":{
      "name":"audio_vae",
      "type":"string",
      "default":"minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt":{
      "name":"prompt",
      "type":"string"
    },
    "width":{
      "name":"width",
      "type":"int",
      "default":864
