{
  "irVersion":1,
  "name":"comfy-workflow-h3-refmod-create-master",
  "nodes":{
    "1":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"audio_vae"
        }
      },
      "inputs":{}
    },
    "3":{
      "type":"MiniMaxH3RefModFolderLoader",
      "params":{
        "folder":{
          "$param":"folder"
        },
        "max_items":{
          "$param":"max_items"
        },
        "max_frames":{
          "$param":"max_frames"
        },
        "max_edge":1024
      },
      "inputs":{},
      "raw":1,
      "outputTypes":[
        "H3_REF_LIST",
        "INT"
      ],
      "outputNames":[
        "refs",
        "count"
      ]
    },
    "4":{
      "type":"LoadAudio",
      "params":{
        "audio":{
          "$param":"audio"
        }
      },
      "inputs":{}
    },
    "5":{
      "type":"MiniMaxH3RefModMasterExtract",
      "params":{
        "name":{
          "$param":"name"
        },
        "mode":{
          "$param":"mode"
        },
        "concept_type":{
          "$param":"concept_type"
        },
        "background_retention":0,
        "ref_resolution":{
          "$param":"ref_resolution"
        },
        "pool_h":16,
        "pool_w":16,
        "latent_frames":16,
        "identity":0,
        "merge":false,
        "motion_only":false,
        "multiplier":1,
        "max_tokens":{
          "$param":"max_tokens"
        },
        "audio_max_seconds":{
          "$param":"max_seconds"
        },
        "audio_max_tokens":5120,
        "audio_budget_policy":"error",
        "audio_concept_type":"voice",
        "max_total_tokens":0,
        "extraction_preset":"manual",
        "subfolder":{
          "$param":"subfolder"
        },
        "description":{
          "$param":"description"
        },
        "save":true,
        "budget_policy":"error",
        "save_layout":{
          "$param":"save_layout"
        }
      },
      "inputs":{
        "refs_bundle":{
          "node":"3",
          "out":0
        },
        "vae":{
          "node":"1",
          "out":0
        },
        "audio":{
          "node":"4",
          "out":0
        },
        "audio_vae":{
          "node":"2",
          "out":0
        }
      },
      "raw":1,
      "outputTypes":[
        "H3_REF_MODS",
        "STRING"
      ],
      "outputNames":[
        "mods",
        "details"
      ]
    }
  },
  "outputs":[
    {
      "node":"5",
      "out":1
    }
  ],
  "params":{
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae":{
      "name":"audio_vae",
      "type":"string",
      "default":"minimax_h3_audio_vae_fp32.safetensors"
    },
    "folder":{
      "name":"folder",
      "type":"string"
    },
    "audio":{
      "name":"audio",
      "type":"combo"
    },
    "name":{
      "name":"name",
      "type":"string",
      "default":"character"
    },
    "mode":{
      "name":"mode",
      "type":"string",
      "default":"Full Reference"
    },
    "concept_type":{
      "name":"concept_type",
      "type":"string",
      "default":"identity"
    },
    "ref_resolution":{
      "name":"ref_resolution",
      "type":"int",
      "default":1024
    },
    "max_tokens":{
      "name":"max_tokens",
      "type":"int",
      "default":8192
    },
    "max_items":{
      "name":"max_items",
      "type":"int",
      "default":32
    },
    "max_frames":{
      "name":"max_frames",
      "type":"int",
      "default":240
    },
    "max_seconds":{
      "name":"max_seconds",
      "type":"float",
      "default":15
    },
    "subfolder":{
      "name":"subfolder",
      "type":"string",
      "default":""
    },
    "description":{
      "name":"description",
      "type":"string",
      "default":""
    },
    "save_layout":{
      "name":"save_layout",
      "type":"string",
      "default":"bundle"
    }
  }
}
