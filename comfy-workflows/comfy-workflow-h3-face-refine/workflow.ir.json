{
  "irVersion":1,
  "name":"comfy-workflow-h3-face-refine",
  "nodes":{
    "1":{
      "type":"LoadVideo",
      "params":{
        "file":{
          "$param":"video"
        }
      },
      "inputs":{}
    },
    "2":{
      "type":"GetVideoComponents",
      "params":{},
      "inputs":{
        "video":{
          "node":"1",
          "out":0
        }
      }
    },
    "3":{
      "type":"H3FaceTrackCrop",
      "params":{
        "detector":{
          "$param":"detector"
        },
        "confidence":0.35,
        "crop_factor":2.5,
        "canvas_width":512,
        "canvas_height":512,
        "canvas_mode":"auto_capped_768",
        "smooth_window":21,
        "size_smooth_window":51,
        "smooth_method":"gaussian",
        "size_mode":"per_frame"
      },
      "inputs":{
        "images":{
          "node":"2",
          "out":0
        }
      }
    },
    "4":{
      "type":"UNETLoader",
      "params":{
        "unet_name":{
          "$param":"unet"
        },
        "weight_dtype":"default"
      },
      "inputs":{}
    },
    "5":{
      "type":"CLIPLoader",
      "params":{
        "clip_name":{
          "$param":"clip"
        },
        "type":"minimax",
        "device":"cpu"
      },
      "inputs":{}
    },
    "6":{
      "type":"VAELoader",
      "params":{
        "vae_name":{
          "$param":"video_vae"
        }
      },
      "inputs":{}
    },
    "7":{
      "type":"MiniMaxH3SigmaShift",
      "params":{
        "shift_video":12,
        "shift_audio":3
      },
      "inputs":{
        "model":{
          "node":"4",
          "out":0
        }
      }
    },
    "8":{
      "type":"MiniMaxH3ImageToVideo",
      "params":{
        "prompt":{
          "$param":"prompt"
        },
        "width":512,
        "height":512,
        "length":{
          "$param":"length"
        }
      },
      "inputs":{
        "clip":{
          "node":"5",
          "out":0
        },
        "vae":{
          "node":"6",
          "out":0
        },
        "width":{
          "node":"3",
          "out":4
        },
        "height":{
          "node":"3",
          "out":5
        }
      }
    },
    "9":{
      "type":"H3InjectVideoLatent",
      "params":{},
      "inputs":{
        "av_latent":{
          "node":"8",
          "out":1
        },
        "images":{
          "node":"3",
          "out":0
        },
        "vae":{
          "node":"6",
          "out":0
        }
      }
    },
    "10":{
      "type":"ConditioningZeroOut",
      "params":{},
      "inputs":{
        "conditioning":{
          "node":"8",
          "out":0
        }
      }
    },
    "11":{
      "type":"KSampler",
      "params":{
        "seed":{
          "$param":"seed"
        },
        "steps":{
          "$param":"steps"
        },
        "cfg":1,
        "sampler_name":"euler",
        "scheduler":"simple",
        "denoise":{
          "$param":"denoise"
        }
      },
      "inputs":{
        "model":{
          "node":"7",
          "out":0
        },
        "positive":{
          "node":"8",
          "out":0
        },
        "negative":{
          "node":"10",
          "out":0
        },
        "latent_image":{
          "node":"9",
          "out":0
        }
      }
    },
    "12":{
      "type":"VAEDecode",
      "params":{},
      "inputs":{
        "samples":{
          "node":"11",
          "out":0
        },
        "vae":{
          "node":"6",
          "out":0
        }
      }
    },
    "13":{
      "type":"H3FaceStitch",
      "params":{
        "paste_region":"face_only",
        "mask_dilation":16,
        "feather":6,
        "colour_match":1,
        "blend":1,
        "undetected_frames":"fade_out"
      },
      "inputs":{
        "base_images":{
          "node":"2",
          "out":0
        },
        "refined_crops":{
          "node":"12",
          "out":0
        },
        "transform":{
          "node":"3",
          "out":1
        }
      }
    },
    "14":{
      "type":"CreateVideo",
      "params":{
        "fps":24
      },
      "inputs":{
        "images":{
          "node":"13",
          "out":0
        },
        "audio":{
          "node":"2",
          "out":1
        }
      }
    },
    "15":{
      "type":"SaveVideo",
      "params":{
        "filename_prefix":{
          "$param":"output_prefix"
        },
        "format":"auto",
        "codec":"auto"
      },
      "inputs":{
        "video":{
          "node":"14",
          "out":0
        }
      }
    }
  },
  "outputs":[
    {
      "node":"15",
      "out":0
    }
  ],
  "params":{
    "video":{
      "name":"video",
      "type":"string"
    },
    "detector":{
      "name":"detector",
      "type":"string",
      "default":"face_yolov8m.pt"
    },
    "unet":{
      "name":"unet",
      "type":"string",
      "default":"minimax_h3_fl2va_pruned_int8_convrot.safetensors"
    },
    "clip":{
      "name":"clip",
      "type":"string",
      "default":"qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae":{
      "name":"video_vae",
      "type":"string",
      "default":"minimax_h3_video_vae_fp16.safetensors"
    },
    "prompt":{
      "name":"prompt",
      "type":"string"
    },
    "length":{
      "name":"length",
      "type":"int",
      "default":124
    },
    "seed":{
      "name":"seed",
      "type":"int",
      "default":42
    },
    "steps":{
      "name":"steps",
      "type":"int",
      "default":8
    },
    "denoise":{
      "name":"denoise",
      "type":"float",
      "default":0.35
    },
    "output_prefix":{
      "name":"output_prefix",
      "type":"string",
      "default":"h3/face"
    }
  }
}
