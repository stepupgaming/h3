{
  "specVersion": 1,
  "name": "comfy-workflow-h3-ref2va-multiref-vsa",
  "title": "H3 Ref2VA multi-ref + VSA",
  "entry": "./workflow.ir.json",
  "description": "Stock Ref2VA two-still graph with Ref2VAVSAGatePatch. Gemmy `--vsa --weights`.",
  "parameters": {
    "unet": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
    },
    "clip": {
      "type": "string",
      "required": false,
      "default": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
    },
    "video_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_video_vae_fp16.safetensors"
    },
    "audio_vae": {
      "type": "string",
      "required": false,
      "default": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "prompt": {
      "type": "string",
      "required": true
    },
    "width": {
      "type": "int",
      "required": false,
      "default": 864
    },
    "height": {
      "type": "int",
      "required": false,
      "default": 480
    },
    "length": {
      "type": "int",
      "required": false,
      "default": 124
    },
    "seed": {
      "type": "int",
      "required": false,
      "default": 42
    },
    "steps": {
      "type": "int",
      "required": false,
      "default": 20
    },
    "denoise": {
      "type": "float",
      "required": false,
      "default": 1
    },
    "shift_video": {
      "type": "int",
      "required": false,
      "default": 12
    },
    "shift_audio": {
      "type": "int",
      "required": false,
      "default": 3
    },
    "ref_image": {
      "type": "string",
      "required": true
    },
    "ref_image_1": {
      "type": "string",
      "required": true
    },
    "latent_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ref2va_multi_av"
    },
    "fingerprint": {
      "type": "string",
      "required": false,
      "default": "{}"
    },
    "output_prefix": {
      "type": "string",
      "required": false,
      "default": "h3/ref2va_multi"
    },
    "gate_file": {
      "type": "string",
      "required": false,
      "default": "fasth3_vsa_gate.safetensors"
    },
    "sparsity": {
      "type": "float",
      "required": false,
      "default": 0.75
    }
  },
  "outputs": [
    {
      "name": "output-0",
      "type": "IMAGE"
    },
    {
      "name": "output-1",
      "type": "IMAGE"
    }
  ],
  "requires": {
    "nodeClasses": [
      "CLIPLoader",
      "ConditioningZeroOut",
      "CreateVideo",
      "GemmyH3SaveAVLatent",
      "KSampler",
      "LoadImage",
      "MiniMaxH3ReferenceToVideo",
      "MiniMaxH3SigmaShift",
      "Ref2VAVSAGatePatch",
      "SaveVideo",
      "UNETLoader",
      "VAEDecode",
      "VAEDecodeAudio",
      "VAELoader"
    ],
    "nodePacks": [],
    "models": [
      {
        "kind": "model",
        "name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors"
      },
      {
        "kind": "model",
        "name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_video_vae_fp16.safetensors"
      },
      {
        "kind": "model",
        "name": "minimax_h3_audio_vae_fp32.safetensors"
      }
    ]
  },
  "coreVersion": "^0.2.0"
}
